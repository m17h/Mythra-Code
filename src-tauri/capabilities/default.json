{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Mythra Code desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "dialog:allow-confirm",
    "notification:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "x-apple.systempreferences:com.apple.preference.security[?]Privacy_LocalNetwork" }]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
