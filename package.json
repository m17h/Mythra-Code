{
  "name": "mythra-code",
  "private": true,
  "version": "1.13.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "node scripts/desktop-build.mjs",
    "benchmark:threads": "node scripts/benchmark-thread-loading.mjs",
    "performance:scorecard": "node scripts/performance-scorecard.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "release:build": "node scripts/release-dispatch.mjs build",
    "release:publish": "node scripts/release-dispatch.mjs publish",
    "release:macos:build": "node scripts/build-release.mjs",
    "release:macos:prepare": "node scripts/prepare-release.mjs",
    "release:macos:publish": "node scripts/publish-release.mjs",
    "release:windows:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File Windows/build.ps1",
    "release:windows:publish": "node Windows/publish-release.mjs",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify:release-config": "node scripts/verify-release-config.mjs",
    "verify:performance": "node scripts/performance-scorecard.mjs --check",
    "lint": "eslint src --max-warnings 0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "verify": "npm run verify:release-config && npm run lint && npm run lint:rust && npm run check && npm run test:run && npm run test:browser && npm run test:rust && npm run build && npm run verify:performance",
    "release:finalize": "node scripts/finalize-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
